<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17">
  <diagram id="docresolve-pipeline" name="DocResolve pipeline">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ main pipeline, left to right ============ -->
        <mxCell id="docs" value="&lt;b&gt;Documents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#52514E&quot;&gt;upload · folder · server path&lt;br&gt;PDF, Word, text, Markdown&lt;/font&gt;"
                style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9BB4A4;dashed=1;fontFamily=Helvetica;fontSize=12;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="meta" value="&lt;b&gt;Document metadata&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#52514E&quot;&gt;status, type, authority, scope&lt;br&gt;inferred, overridable&lt;/font&gt;"
                style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F7F5;strokeColor=#9BB4A4;fontFamily=Helvetica;fontSize=12;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="218" y="120" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="retr" value="&lt;b&gt;Hybrid retrieval&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#52514E&quot;&gt;BM25 + dense, reciprocal rank fusion&lt;br&gt;top-30 chunks&lt;/font&gt;"
                style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F7F5;strokeColor=#9BB4A4;fontFamily=Helvetica;fontSize=12;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="396" y="120" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="score" value="&lt;b&gt;Governance scoring&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#52514E&quot;&gt;semantic + gate × (authority, scope)&lt;/font&gt;"
                style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F7F5;strokeColor=#9BB4A4;fontFamily=Helvetica;fontSize=12;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="574" y="120" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="div" value="&lt;b&gt;Conflict diversification&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#52514E&quot;&gt;one chunk per distinct claim first,&lt;br&gt;8 kept&lt;/font&gt;"
                style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F7F5;strokeColor=#9BB4A4;fontFamily=Helvetica;fontSize=12;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="752" y="120" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="gen" value="&lt;b&gt;Answer-and-flag generation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#52514E&quot;&gt;corroboration summary in the prompt;&lt;br&gt;verbatim quotes required&lt;/font&gt;"
                style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F7F5;strokeColor=#9BB4A4;fontFamily=Helvetica;fontSize=12;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="930" y="120" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="val" value="&lt;b&gt;Validation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#52514E&quot;&gt;decision allowed, quotes verbatim&lt;br&gt;one repair, then salvage&lt;/font&gt;"
                style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F7F5;strokeColor=#9BB4A4;fontFamily=Helvetica;fontSize=12;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="1108" y="120" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="&lt;b&gt;Evidence review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#52514E&quot;&gt;answer · &lt;font color=&quot;#B7791F&quot;&gt;dissent&lt;/font&gt; · corroboration counts&lt;br&gt;highlighted sentences in the original file&lt;/font&gt;"
                style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F3EC;strokeColor=#1F7A4D;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="1286" y="120" width="170" height="90" as="geometry" />
        </mxCell>

        <!-- pipeline arrows -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=blockThin;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;" edge="1" parent="1" source="docs" target="meta"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=blockThin;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;" edge="1" parent="1" source="meta" target="retr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=blockThin;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;" edge="1" parent="1" source="retr" target="score"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=blockThin;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;" edge="1" parent="1" source="score" target="div"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=blockThin;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;" edge="1" parent="1" source="div" target="gen"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=blockThin;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;" edge="1" parent="1" source="gen" target="val"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=blockThin;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;" edge="1" parent="1" source="val" target="ui"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ resolution order under the generator ============ -->
        <mxCell id="rules" value="resolution order, fixed and stated to the model"
                style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9BB4A4;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontFamily=Helvetica;fontSize=10;fontColor=#52514E;" vertex="1" parent="1">
          <mxGeometry x="707" y="268" width="596" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;1. governance&lt;/b&gt;&lt;br&gt;active authoritative source wins"
                style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9BB4A4;fontFamily=Helvetica;fontSize=10;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="717" y="298" width="135" height="58" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;2. corroboration&lt;/b&gt;&lt;br&gt;distinct documents per value, not repeated chunks"
                style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9BB4A4;fontFamily=Helvetica;fontSize=10;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="864" y="298" width="135" height="58" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;3. consistency&lt;/b&gt;&lt;br&gt;of the source itself"
                style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9BB4A4;fontFamily=Helvetica;fontSize=10;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="1011" y="298" width="135" height="58" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;4. tie&lt;/b&gt;&lt;br&gt;declared; both values shown"
                style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9BB4A4;fontFamily=Helvetica;fontSize=10;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="1158" y="298" width="135" height="58" as="geometry" />
        </mxCell>
        <mxCell id="re1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=blockThin;endFill=1;strokeColor=#6B7280;strokeWidth=1;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=blockThin;endFill=1;strokeColor=#6B7280;strokeWidth=1;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=blockThin;endFill=1;strokeColor=#6B7280;strokeWidth=1;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rules-to-gen" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=blockThin;endFill=1;strokeColor=#6B7280;strokeWidth=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="rules" target="gen"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ reviewer override loop ============ -->
        <mxCell id="override" value="reviewer overrides a document's status  →  re-index, re-evaluate"
                style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=blockThin;endFill=1;strokeColor=#B7791F;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=10;fontColor=#B7791F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="ui" target="meta">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1371" y="420" />
              <mxPoint x="293" y="420" />
            </Array>
            <mxPoint x="-120" y="10" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- ============ output legend ============ -->
        <mxCell id="legend" value="decision ∈ { answered, answered-with-dissent, unresolved conflict, insufficient evidence, needs information }"
                style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontColor=#52514E;" vertex="1" parent="1">
          <mxGeometry x="1256" y="222" width="230" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
